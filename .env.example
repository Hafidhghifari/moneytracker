# Salin file ini menjadi .env: cp .env.example .env
# PostgreSQL container memakai host port 55432 agar tidak bentrok dengan database Docker lain.
DATABASE_URL="postgresql://moneyhist:moneyhist@localhost:55432/moneyhist?schema=public"
# Isi dengan secret acak untuk cookie session production (contoh: openssl rand -base64 32).
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
